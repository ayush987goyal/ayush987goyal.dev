---
---

<div class="inline-flex flex-col items-center gap-1.5 shrink-0">
  <div
    id="cubeScene"
    class="cube-scene"
    tabindex="0"
    role="button"
    aria-label="Interactive 3D Rubik's Cube. Drag or use arrow keys to rotate, click or press Enter for a turn, double-click or press R to solve."
    title="Drag to rotate · Click for a turn · Double-click to solve"
  >
    <div id="cube3d" class="cube-3d">
      <div class="cube-face face-F" data-face="F"></div>
      <div class="cube-face face-B" data-face="B"></div>
      <div class="cube-face face-R" data-face="R"></div>
      <div class="cube-face face-L" data-face="L"></div>
      <div class="cube-face face-U" data-face="U"></div>
      <div class="cube-face face-D" data-face="D"></div>
    </div>
    <div class="cube-shadow" aria-hidden="true"></div>
  </div>
  <span
    class="font-mono text-xs tracking-[0.12em] uppercase text-[var(--fg-subtle)] select-none"
    aria-hidden="true"
  >
    drag · turn
  </span>
</div>

<style>
  .cube-scene {
    width: 96px;
    height: 102px;
    perspective: 420px;
    position: relative;
    cursor: grab;
    user-select: none;
    touch-action: none;
  }
  .cube-scene:active {
    cursor: grabbing;
  }
  .cube-shadow {
    position: absolute;
    bottom: 2px;
    left: 50%;
    width: 60px;
    height: 13px;
    transform: translateX(-50%);
    border-radius: 999px;
    background: radial-gradient(ellipse at center, rgba(24, 22, 20, 0.24) 0%, rgba(24, 22, 20, 0) 72%);
    filter: blur(2px);
    pointer-events: none;
  }
  :global(html.dark) .cube-shadow {
    background: radial-gradient(ellipse at center, rgba(229, 176, 114, 0.16) 0%, rgba(0, 0, 0, 0) 76%);
  }
  .cube-3d {
    width: 66px;
    height: 66px;
    position: absolute;
    top: 11px;
    left: 15px;
    transform-style: preserve-3d;
  }
  .cube-face {
    position: absolute;
    width: 66px;
    height: 66px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 1fr);
    gap: 2.5px;
    padding: 3.5px;
    border-radius: 5px;
    background: #1a1816;
    border: 1px solid rgba(255, 255, 255, 0.1);
    backface-visibility: hidden;
  }
  :global(html.dark) .cube-face {
    background: #2b2723;
    border: 1px solid rgba(255, 245, 230, 0.2);
  }
  .cube-face :global(.sticker) {
    border-radius: 2px;
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.24);
    transition: background-color 180ms ease;
  }
  .face-F { transform: rotateY(0deg) translateZ(33px); }
  .face-B { transform: rotateY(180deg) translateZ(33px); }
  .face-R { transform: rotateY(90deg) translateZ(33px); }
  .face-L { transform: rotateY(-90deg) translateZ(33px); }
  .face-U { transform: rotateX(90deg) translateZ(33px); }
  .face-D { transform: rotateX(-90deg) translateZ(33px); }

  /* Warm editorial sticker palette */
  .cube-face :global(.c-W) { background-color: #f7f4ee; }
  .cube-face :global(.c-Y) { background-color: #eab308; }
  .cube-face :global(.c-G) { background-color: #15803d; }
  .cube-face :global(.c-B) { background-color: #2563eb; }
  .cube-face :global(.c-R) { background-color: #c84b31; }
  .cube-face :global(.c-O) { background-color: #ea7a2b; }
</style>

<script>
  type Face = 'U' | 'D' | 'F' | 'B' | 'R' | 'L';
  type Color = 'W' | 'Y' | 'G' | 'B' | 'R' | 'O';

  const FACE_DEFAULT: Record<Face, Color> = { U: 'W', D: 'Y', F: 'G', B: 'B', R: 'R', L: 'O' };
  const MOVES = ['U', "U'", 'R', "R'", 'F', "F'", 'L', "L'", 'D', "D'", 'B', "B'"] as const;

  const cubeState: Record<Face, Color[]> = {
    U: [], D: [], F: [], B: [], R: [], L: [],
  };

  function resetCubeState() {
    (Object.keys(FACE_DEFAULT) as Face[]).forEach((f) => {
      cubeState[f] = Array<Color>(9).fill(FACE_DEFAULT[f]);
    });
  }

  function rotateFaceCW(arr: Color[]): Color[] {
    return [arr[6], arr[3], arr[0], arr[7], arr[4], arr[1], arr[8], arr[5], arr[2]];
  }

  function applyQuarterTurn(face: Face) {
    cubeState[face] = rotateFaceCW(cubeState[face]);
    const s = cubeState;
    let t: [Color, Color, Color];
    if (face === 'U') {
      t = [s.F[0], s.F[1], s.F[2]];
      [s.F[0], s.F[1], s.F[2]] = [s.R[0], s.R[1], s.R[2]];
      [s.R[0], s.R[1], s.R[2]] = [s.B[0], s.B[1], s.B[2]];
      [s.B[0], s.B[1], s.B[2]] = [s.L[0], s.L[1], s.L[2]];
      [s.L[0], s.L[1], s.L[2]] = t;
    } else if (face === 'D') {
      t = [s.F[6], s.F[7], s.F[8]];
      [s.F[6], s.F[7], s.F[8]] = [s.L[6], s.L[7], s.L[8]];
      [s.L[6], s.L[7], s.L[8]] = [s.B[6], s.B[7], s.B[8]];
      [s.B[6], s.B[7], s.B[8]] = [s.R[6], s.R[7], s.R[8]];
      [s.R[6], s.R[7], s.R[8]] = t;
    } else if (face === 'R') {
      t = [s.U[2], s.U[5], s.U[8]];
      [s.U[2], s.U[5], s.U[8]] = [s.F[2], s.F[5], s.F[8]];
      [s.F[2], s.F[5], s.F[8]] = [s.D[2], s.D[5], s.D[8]];
      [s.D[2], s.D[5], s.D[8]] = [s.B[6], s.B[3], s.B[0]];
      [s.B[6], s.B[3], s.B[0]] = t;
    } else if (face === 'L') {
      t = [s.U[0], s.U[3], s.U[6]];
      [s.U[0], s.U[3], s.U[6]] = [s.B[8], s.B[5], s.B[2]];
      [s.B[8], s.B[5], s.B[2]] = [s.D[0], s.D[3], s.D[6]];
      [s.D[0], s.D[3], s.D[6]] = [s.F[0], s.F[3], s.F[6]];
      [s.F[0], s.F[3], s.F[6]] = t;
    } else if (face === 'F') {
      t = [s.U[6], s.U[7], s.U[8]];
      [s.U[6], s.U[7], s.U[8]] = [s.L[8], s.L[5], s.L[2]];
      [s.L[8], s.L[5], s.L[2]] = [s.D[2], s.D[1], s.D[0]];
      [s.D[2], s.D[1], s.D[0]] = [s.R[0], s.R[3], s.R[6]];
      [s.R[0], s.R[3], s.R[6]] = t;
    } else if (face === 'B') {
      t = [s.U[0], s.U[1], s.U[2]];
      [s.U[0], s.U[1], s.U[2]] = [s.R[2], s.R[5], s.R[8]];
      [s.R[2], s.R[5], s.R[8]] = [s.D[8], s.D[7], s.D[6]];
      [s.D[8], s.D[7], s.D[6]] = [s.L[6], s.L[3], s.L[0]];
      [s.L[6], s.L[3], s.L[0]] = t;
    }
  }

  function applyMove(notation: string) {
    const face = notation[0] as Face;
    const turns = notation.endsWith("'") ? 3 : 1;
    for (let i = 0; i < turns; i++) applyQuarterTurn(face);
  }

  const cubeScene = document.getElementById('cubeScene');
  const cube3d = document.getElementById('cube3d');

  if (cubeScene && cube3d) {
    const renderStickers = () => {
      cube3d.querySelectorAll<HTMLElement>('.cube-face').forEach((faceEl) => {
        const face = faceEl.dataset.face as Face;
        if (!faceEl.children.length) {
          for (let i = 0; i < 9; i++) {
            const div = document.createElement('div');
            div.className = 'sticker';
            faceEl.appendChild(div);
          }
        }
        Array.from(faceEl.children).forEach((el, idx) => {
          el.className = `sticker c-${cubeState[face][idx]}`;
        });
      });
    };

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let rotX = -24;
    let rotY = 28;
    let dragging = false;
    let hovered = false;
    let focused = false;
    let visible = false;
    let moved = false;
    let lastX = 0;
    let lastY = 0;
    let rafId: number | null = null;

    const updateTransform = () => {
      cube3d.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg)`;
    };

    const doRandomTurn = () => {
      const nextMove = MOVES[Math.floor(Math.random() * MOVES.length)];
      applyMove(nextMove);
      renderStickers();
    };

    const stopLoop = () => {
      if (rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
    };

    const loop = () => {
      if (!visible || reducedMotion) {
        stopLoop();
        return;
      }
      if (!dragging && !hovered && !focused) {
        rotY += 0.16;
        updateTransform();
      }
      rafId = requestAnimationFrame(loop);
    };

    const startLoop = () => {
      if (!reducedMotion && visible && rafId === null) {
        rafId = requestAnimationFrame(loop);
      }
    };

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          visible = entries[0]?.isIntersecting ?? false;
          if (visible) startLoop();
          else stopLoop();
        },
        { threshold: 0.05 }
      );
      io.observe(cubeScene);
    } else {
      visible = true;
      startLoop();
    }

    cubeScene.addEventListener('pointerenter', () => {
      hovered = true;
    });
    cubeScene.addEventListener('pointerleave', () => {
      hovered = false;
    });
    cubeScene.addEventListener('focus', () => {
      focused = true;
    });
    cubeScene.addEventListener('blur', () => {
      focused = false;
    });

    cubeScene.addEventListener('pointerdown', (e) => {
      dragging = true;
      moved = false;
      lastX = e.clientX;
      lastY = e.clientY;
      cubeScene.setPointerCapture(e.pointerId);
    });

    cubeScene.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - lastX;
      const dy = e.clientY - lastY;
      if (Math.abs(dx) + Math.abs(dy) > 3) moved = true;
      rotY += dx * 0.75;
      rotX -= dy * 0.75;
      lastX = e.clientX;
      lastY = e.clientY;
      updateTransform();
    });

    cubeScene.addEventListener('pointerup', () => {
      if (!moved) doRandomTurn();
      dragging = false;
    });

    cubeScene.addEventListener('dblclick', () => {
      resetCubeState();
      renderStickers();
    });

    cubeScene.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        doRandomTurn();
      } else if (e.key.toLowerCase() === 'r') {
        e.preventDefault();
        resetCubeState();
        renderStickers();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        rotY -= 20;
        updateTransform();
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        rotY += 20;
        updateTransform();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        rotX += 20;
        updateTransform();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        rotX -= 20;
        updateTransform();
      }
    });

    // Start with a tasteful solved-plus-3-move pattern (double-click or press R to solve)
    resetCubeState();
    ['R', 'U', "F'"].forEach(applyMove);
    renderStickers();
    updateTransform();
  }
</script>
