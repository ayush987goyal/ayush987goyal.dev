---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import { PROFILE } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${PROFILE.name} — Staff Software Engineer`,
  description = PROFILE.bio,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const cfToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: PROFILE.name,
  jobTitle: 'Staff Software Engineer',
  worksFor: { '@type': 'Organization', name: 'Google' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Indian Institute of Technology, Roorkee' },
  url: `https://${PROFILE.domain}`,
  sameAs: [PROFILE.links.github, PROFILE.links.linkedin, PROFILE.links.wca],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bengaluru',
    addressRegion: 'Karnataka',
    addressCountry: 'IN',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#fdfaf5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121110" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={PROFILE.domain} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

    <!-- Zero-FOUC theme initialization -->
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col paper-grain">
    <slot />

    <!-- Vercel Web Analytics (zero-config on Vercel) -->
    <Analytics />

    <!-- Optional Cloudflare Web Analytics -->
    {
      cfToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfToken })}
        />
      )
    }
  </body>
</html>
