---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import { PROFILE } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  bodyClass?: string;
}

const {
  title = `${PROFILE.name} — ${PROFILE.role}`,
  description = PROFILE.metaDescription,
  ogType = 'website',
  bodyClass = 'min-h-screen flex flex-col paper-grain',
} = Astro.props;

const normalizedPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, '');
const canonicalUrl = new URL(normalizedPath, Astro.site);
const ogImageUrl = new URL('/og.png', Astro.site);
const avatarImageUrl = new URL('/avatar.jpg', Astro.site);
const rssUrl = new URL('/rss.xml', Astro.site);
const cfToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: PROFILE.name,
  jobTitle: 'Staff Software Engineer',
  worksFor: { '@type': 'Organization', name: 'Google' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Indian Institute of Technology, Roorkee' },
  url: `https://${PROFILE.domain}`,
  image: avatarImageUrl.toString(),
  sameAs: [PROFILE.links.github, PROFILE.links.linkedin, PROFILE.links.wca],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bengaluru',
    addressRegion: 'Karnataka',
    addressCountry: 'IN',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${PROFILE.name} — Writing`} href={rssUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#fdfaf5" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={PROFILE.domain} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${PROFILE.name} — ${PROFILE.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  </head>
  <body class={bodyClass}>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot />

    <!-- Vercel Web Analytics (zero-config on Vercel) -->
    <Analytics />

    <!-- Optional Cloudflare Web Analytics -->
    {
      cfToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfToken })}
        />
      )
    }
  </body>
</html>
