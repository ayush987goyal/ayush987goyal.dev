---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CommandPalette from '../components/CommandPalette.astro';
import WcaSection from '../components/WcaSection.astro';
import { EDUCATION, EXPERIENCE, FEATURED_OSS, LIVE_APPS, PROFILE } from '../data/profile';
import { getWcaProfile } from '../lib/wca';

const wca = await getWcaProfile(PROFILE.wcaId);
const publishedPosts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
---

<BaseLayout>
  <SiteHeader active="home" />

  <main id="main-content" class="flex-1">
    <!-- =================================================================== -->
    <!-- CHAPTER I: WARM LITERARY PAPER HERO + CAREER DISPATCH               -->
    <!-- =================================================================== -->
    <div id="top" class="max-w-5xl mx-auto px-5 sm:px-10 pt-10 sm:pt-16 pb-14 sm:pb-16 space-y-12">
      <!-- Editorial Hero Spread -->
      <section class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-8 items-end">
        <div class="md:col-span-9 space-y-6">
          <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--accent)]">
            {PROFILE.role} · {PROFILE.location}
          </p>

          <h1 class="font-editorial font-normal text-[40px] sm:text-[56px] lg:text-[64px] leading-[1.0] tracking-[-0.032em] text-[var(--fg)]">
            Building <em class="italic">resilient</em> software,{' '}<br class="hidden sm:inline" />from cloud engines to{' '}<br class="hidden sm:inline" />human interfaces.
          </h1>

          <p class="text-[16px] sm:text-[17px] leading-[1.64] text-[var(--fg-muted)] max-w-[60ch]">
            I'm <strong class="font-medium text-[var(--fg)]">{PROFILE.name}</strong>, a Staff Software Engineer at
            <strong class="font-medium text-[var(--fg)]"> Google</strong>. Over the past{' '}
            <span class="editorial-mark font-medium text-[var(--fg)]">10+ years</span> — spanning seven years at Amazon (AWS Bedrock, AI Computer Vision, Pharmacy), Goldman Sachs, and Citi — I've focused on turning complex infrastructure into calm, enduring software.
          </p>

          <!-- Hairline Underlined Action Links (Generous mobile touch targets) -->
          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 pt-1 text-[14px]">
            <span class="inline-flex items-baseline gap-2.5 py-1.5">
              <a
                href={`mailto:${PROFILE.email}`}
                class="text-[var(--fg)] font-medium underline decoration-[var(--accent)] underline-offset-4 decoration-1 hover:text-[var(--accent)] transition-colors"
              >
                {PROFILE.email}
              </a>
              <button
                id="copyEmailBtn"
                type="button"
                aria-label={`Copy ${PROFILE.email} to clipboard`}
                class="font-mono text-[11px] px-1.5 py-0.5 border border-[var(--border)] text-[var(--fg-subtle)] hover:text-[var(--fg)] hover:border-[var(--border-strong)] transition-colors cursor-pointer"
              >
                <span id="copyEmailLabel">copy</span>
              </button>
            </span>
            <a href={PROFILE.links.github} target="_blank" rel="noopener" class="editorial-link py-1.5 text-[var(--fg-muted)]">
              GitHub ↗
            </a>
            <a href={PROFILE.links.linkedin} target="_blank" rel="noopener" class="editorial-link py-1.5 text-[var(--fg-muted)]">
              LinkedIn ↗
            </a>
            <a href={PROFILE.links.wca} target="_blank" rel="noopener" class="editorial-link py-1.5 text-[var(--fg-muted)]">
              WCA {PROFILE.wcaId} ↗
            </a>
          </div>
        </div>

        <!-- Editorial Portrait Stamp (Tightly aligned caption within column width) -->
        <div class="md:col-span-3 flex md:flex-col items-center md:items-end justify-start gap-4">
          <figure class="w-32 sm:w-36 p-1.5 border border-[var(--border-strong)] bg-[var(--surface)] shrink-0">
            <div class="w-full aspect-square overflow-hidden bg-[var(--chapter-bg)] relative">
              <img
                src="/avatar.jpg"
                alt={PROFILE.name}
                width="144"
                height="144"
                loading="eager"
                class="w-full h-full object-cover object-[44%_12%] scale-[1.78] origin-[44%_12%] portrait-stamp"
              />
            </div>
            <figcaption class="mt-1.5 font-mono text-[11px] uppercase tracking-[0.12em] text-center text-[var(--fg-subtle)]">
              {PROFILE.coordinates}
            </figcaption>
          </figure>

          <div class="md:w-36 text-left md:text-right font-mono text-[11px] text-[var(--fg-subtle)] leading-snug space-y-0.5">
            <div class="text-[var(--fg)]">Vol. IV · 2026</div>
            <div>IIT Roorkee</div>
            <div>{wca.medals.total} WCA Medals</div>
          </div>
        </div>
      </section>

      <!-- Hand-drawn Editorial Squiggle Divider -->
      <div class="flex items-center gap-4 text-[var(--accent)]/80 pt-2">
        <svg width="108" height="10" viewBox="0 0 108 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="shrink-0">
          <path
            d="M1 5.5C9 1.5 16 9.5 24 5.5C32 1.5 39 9.5 47 5.5C55 1.5 62 9.5 70 5.5C78 1.5 85 9.5 93 5.5C100 2 104 7 107 5"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linecap="round"
          />
        </svg>
        <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--fg-subtle)]">
          Career Dispatch · 2012–2026
        </span>
      </div>

      <!-- 3-Column Print-Style Career Strip + Expandable Full Ledger -->
      <section id="experience" class="space-y-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-7 md:gap-0">
          <article class="space-y-2 md:pr-7 rule-dotted-r-md pb-6 md:pb-0 rule-dotted-b-mobile">
            <div class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--accent)]">
              Jul 2026 – Present
            </div>
            <h2 class="font-editorial font-normal text-[28px] leading-tight text-[var(--fg)]">Google</h2>
            <p class="text-[14px] leading-[1.6] text-[var(--fg-muted)]">
              <strong class="font-medium text-[var(--fg)]">Staff Software Engineer.</strong> Full-stack architecture and technical leadership out of Bengaluru.
            </p>
          </article>

          <article class="space-y-2 md:px-7 rule-dotted-r-md pb-6 md:pb-0 rule-dotted-b-mobile">
            <div class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--fg-subtle)]">
              7 Years · 2019 – 2026
            </div>
            <h2 class="font-editorial font-normal text-[28px] leading-tight text-[var(--fg)]">Amazon &amp; AWS</h2>
            <p class="text-[14px] leading-[1.6] text-[var(--fg-muted)]">
              Senior SDE at <strong class="font-medium text-[var(--fg)]">Pharmacy</strong>; Senior FEE on
              <strong class="font-medium text-[var(--fg)]"> AWS Bedrock</strong> (Data Automation &amp; MCP) &amp;
              <strong class="font-medium text-[var(--fg)]"> AI Computer Vision</strong> (2023 re:Invent Award).
            </p>
          </article>

          <article class="space-y-2 md:pl-7">
            <div class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--fg-subtle)]">
              Foundations · 2012 – 2019
            </div>
            <h2 class="font-editorial font-normal text-[28px] leading-tight text-[var(--fg)]">GS · Citi · IITR</h2>
            <p class="text-[14px] leading-[1.6] text-[var(--fg-muted)]">
              Trade-compliance lead at <strong class="font-medium text-[var(--fg)]">Goldman Sachs</strong>, core C++ equities pricing at
              <strong class="font-medium text-[var(--fg)]"> Citi</strong>, and ChemE honors at
              <strong class="font-medium text-[var(--fg)]"> IIT Roorkee</strong>.
            </p>
          </article>
        </div>

        <!-- Expandable Full Role Ledger (Clear accordion disclosure affordance) -->
        <details class="group rule-dotted-t pt-5">
          <summary class="inline-flex items-center gap-2 py-1.5 font-mono text-xs text-[var(--fg-muted)] hover:text-[var(--accent)] transition-colors cursor-pointer select-none">
            <span class="underline decoration-[var(--border-strong)] underline-offset-4 group-hover:decoration-[var(--accent)]">
              Expand full role history &amp; research (2012–2026)
            </span>
            <span class="inline-block transition-transform duration-200 group-open:rotate-180" aria-hidden="true">▾</span>
          </summary>

          <div class="mt-6 divide-y divide-dotted divide-[var(--border-dotted)] rule-dotted-t rule-dotted-b">
            {
              EXPERIENCE.map((item) => (
                <div class="py-5 grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-6">
                  <div class="md:col-span-3 space-y-0.5">
                    <div class="font-mono text-[11px] text-[var(--fg-subtle)]">{item.period}</div>
                    <div class="font-mono text-[11px] text-[var(--fg-subtle)]">{item.location}</div>
                  </div>
                  <div class="md:col-span-9 space-y-2.5">
                    <div class="flex flex-wrap items-baseline gap-x-2">
                      <h3 class="font-editorial text-xl text-[var(--fg)]">{item.company}</h3>
                      <span class="font-editorial italic text-[15px] text-[var(--fg-subtle)]">— {item.headlineRole}</span>
                    </div>
                    {item.summary && (
                      <p class="text-[13.5px] leading-relaxed text-[var(--fg-muted)]">{item.summary}</p>
                    )}
                    {item.roles && (
                      <div class="pt-1 space-y-3 border-l border-dotted border-[var(--border-dotted)] pl-4">
                        {item.roles.map((r) => (
                          <div class="space-y-0.5">
                            <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-0.5 text-[13px]">
                              <div>
                                <span class="font-medium text-[var(--fg)]">{r.team}</span>
                                <span class="text-[var(--fg-subtle)]"> · {r.title}</span>
                              </div>
                              <span class="font-mono text-[11px] text-[var(--fg-subtle)]">{r.period}</span>
                            </div>
                            {r.summary && (
                              <p class="text-[13px] leading-relaxed text-[var(--fg-muted)]">{r.summary}</p>
                            )}
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              ))
            }

            <!-- Education & Research -->
            <div class="py-5 grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-6">
              <div class="md:col-span-3 space-y-0.5">
                <div class="font-mono text-[11px] text-[var(--fg-subtle)]">{EDUCATION.period}</div>
                <div class="font-mono text-[11px] text-[var(--fg-subtle)]">Roorkee · Windsor · Pune</div>
              </div>
              <div class="md:col-span-9 space-y-1.5">
                <div class="flex flex-wrap items-baseline gap-x-2">
                  <h3 class="font-editorial text-xl text-[var(--fg)]">{EDUCATION.institution}</h3>
                  <span class="font-editorial italic text-[15px] text-[var(--fg-subtle)]">— {EDUCATION.degree}</span>
                </div>
                <p class="text-[13.5px] leading-relaxed text-[var(--fg-muted)]">{EDUCATION.highlights}</p>
              </div>
            </div>
          </div>
        </details>
      </section>
    </div>

    <!-- =================================================================== -->
    <!-- CHAPTER II: DEEP ESPRESSO EDITORIAL CHAPTER (3-Act contrast band)   -->
    <!-- =================================================================== -->
    <section
      id="work"
      class="chapter-band bg-[var(--chapter-bg)] text-[var(--chapter-fg)] rule-chapter-t rule-chapter-b"
    >
      <div class="max-w-5xl mx-auto px-5 sm:px-10 py-14 sm:py-16 space-y-8">
        <!-- Chapter Masthead & Accessible Filter Tabs -->
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 rule-chapter-b pb-5">
          <div class="space-y-1.5">
            <div class="font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--chapter-accent)]">
              Index · Open Source &amp; Builds
            </div>
            <h2 class="font-editorial font-normal text-3xl sm:text-[42px] leading-[1.05] tracking-[-0.025em] text-[var(--chapter-fg)]">
              Things shipped in the <em class="italic text-[var(--chapter-accent)]">open</em>.
            </h2>
          </div>

          <div role="tablist" aria-label="Filter projects by category" class="flex items-center gap-5 text-xs font-mono">
            <button
              type="button"
              role="tab"
              aria-selected="true"
              aria-controls="workNewspaper"
              data-work-tab="all"
              class="work-tab py-1.5 min-h-[38px] text-[var(--chapter-fg)] border-b-2 border-[var(--chapter-accent)] font-medium transition-colors cursor-pointer"
            >
              All
            </button>
            <button
              type="button"
              role="tab"
              aria-selected="false"
              aria-controls="workOssCol"
              data-work-tab="oss"
              class="work-tab py-1.5 min-h-[38px] text-[var(--chapter-subtle)] border-b-2 border-transparent hover:text-[var(--chapter-fg)] transition-colors cursor-pointer"
            >
              Open Source
            </button>
            <button
              type="button"
              role="tab"
              aria-selected="false"
              aria-controls="workAppCol"
              data-work-tab="app"
              class="work-tab py-1.5 min-h-[38px] text-[var(--chapter-subtle)] border-b-2 border-transparent hover:text-[var(--chapter-fg)] transition-colors cursor-pointer"
            >
              Live Apps
            </button>
          </div>
        </div>

        <!-- Asymmetric Newspaper Dotted Grid -->
        <div id="workNewspaper" class="grid grid-cols-1 md:grid-cols-12 gap-0 rule-chapter-b">
          <!-- Lead Features: AWSLabs Bedrock MCP (2025) & AWS CDK (2021) -->
          <div
            id="workOssCol"
            data-work-kind="oss"
            class="md:col-span-7 md:pr-9 rule-chapter-r-md rule-chapter-b-mobile divide-y divide-dotted divide-[var(--chapter-rule)]"
          >
            {
              FEATURED_OSS.map((feat) => (
                <article class="py-6 space-y-4">
                  <div class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--chapter-accent)]">
                    {feat.eyebrow}
                  </div>

                  <h3 class="font-editorial font-normal text-[28px] sm:text-[32px] leading-[1.1] tracking-[-0.02em] text-[var(--chapter-fg)]">
                    {feat.title} <em class="italic text-[#dfd6c9]">{feat.titleAccent}</em> {feat.titleTail}
                  </h3>

                  <p class="text-[14px] leading-[1.66] text-[var(--chapter-muted)]">
                    {feat.description}
                  </p>

                  {feat.hasCodeSpecimen && (
                    <pre class="bg-[var(--chapter-surface)] border border-[var(--chapter-rule)] px-4 py-3 font-mono text-[11.5px] leading-relaxed text-[#dfd8cd] overflow-x-auto"><code><span class="text-[#a3998c]">// aws/aws-cdk PR #12436 · StepFunctions</span>
<span class="text-[var(--chapter-accent)]">new</span> tasks.EcsRunTask(this, <span class="text-[#e0ae78]">'RunJob'</span>, &#123;
  taskDefinition,
  revisionNumber: <span class="text-[#f0cf90]">Revision.LATEST</span>,
&#125;);</code></pre>
                  )}

                  <!-- Inline Editorial Arrows (no marooned right-edge gaps) -->
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2.5 pt-1 font-mono text-xs">
                    {feat.links.map((item) => (
                      <a
                        href={item.url}
                        target="_blank"
                        rel="noopener"
                        class="inline-flex items-baseline gap-1.5 py-1.5 text-[var(--chapter-accent)] border-b border-dotted border-[var(--chapter-rule)] hover:text-[var(--chapter-fg)] hover:border-[var(--chapter-accent)] transition-colors"
                      >
                        <span>{item.label}</span>
                        <span class="shrink-0" aria-hidden="true">↗</span>
                      </a>
                    ))}
                  </div>
                </article>
              ))
            }
          </div>

          <!-- Secondary Dispatch Column: Live Weekend Web Apps (Natural top-aligned rhythm, zero dead voids) -->
          <div
            id="workAppCol"
            data-work-kind="app"
            class="md:col-span-5 md:pl-9 divide-y divide-dotted divide-[var(--chapter-rule)] flex flex-col justify-start self-start"
          >
            {
              LIVE_APPS.map((app) => (
                <article class="py-6 space-y-2.5 group">
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--chapter-subtle)]">
                      {app.badge}
                    </span>
                    <div class="flex items-center gap-2 font-mono text-xs">
                      {app.repoUrl && (
                        <>
                          <a
                            href={app.repoUrl}
                            target="_blank"
                            rel="noopener"
                            class="py-1 text-[var(--chapter-muted)] hover:text-[var(--chapter-fg)] transition-colors"
                          >
                            Source
                          </a>
                          <span class="text-[var(--chapter-rule)]" aria-hidden="true">·</span>
                        </>
                      )}
                      <a
                        href={app.url}
                        target="_blank"
                        rel="noopener"
                        class="py-1 text-[var(--chapter-accent)] hover:text-[var(--chapter-fg)] transition-colors"
                      >
                        Open ↗
                      </a>
                    </div>
                  </div>

                  <h3 class="font-editorial font-normal text-[22px] leading-snug text-[var(--chapter-fg)]">
                    <a
                      href={app.url}
                      target="_blank"
                      rel="noopener"
                      class="hover:text-[var(--chapter-accent)] transition-colors"
                    >
                      {app.title}
                    </a>
                  </h3>

                  <p class="text-[13.5px] leading-[1.6] text-[var(--chapter-muted)]">
                    {app.description}
                  </p>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- CHAPTER III: SPEEDCUBING SPECIMEN SHEET (Back to Warm Paper)        -->
    <!-- =================================================================== -->
    <WcaSection wca={wca} />

    <!-- Optional Writing Preview (auto-renders once local MDX essays exist) -->
    {
      publishedPosts.length > 0 && (
        <section id="writing" class="max-w-5xl mx-auto px-5 sm:px-10 pb-14 space-y-5">
          <div class="flex items-baseline justify-between rule-dotted-b pb-3">
            <h2 class="font-editorial font-normal text-3xl text-[var(--fg)]">Notes &amp; Essays</h2>
            <a href="/writing" class="font-mono text-xs text-[var(--accent)] hover:underline underline-offset-4">
              All notes ↗
            </a>
          </div>
          <ul class="divide-y divide-dotted divide-[var(--border-dotted)]">
            {publishedPosts.slice(0, 4).map((post) => (
              <li class="py-3.5 first:pt-0">
                <a
                  href={`/writing/${post.id}`}
                  class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 group"
                >
                  <span class="font-editorial text-xl text-[var(--fg)] group-hover:text-[var(--accent)] transition-colors">
                    {post.data.title}
                  </span>
                  <time
                    datetime={post.data.publishedAt.toISOString()}
                    class="font-mono text-xs text-[var(--fg-subtle)] shrink-0"
                  >
                    {post.data.publishedAt.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                    })}
                  </time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>

  <SiteFooter />
  <CommandPalette />
</BaseLayout>

<script>
  // Honest Copy Email button (with timeout clear + global toast fallback)
  const copyBtn = document.getElementById('copyEmailBtn') as HTMLButtonElement | null;
  const copyLabel = document.getElementById('copyEmailLabel');
  let copyTimer: number | null = null;

  copyBtn?.addEventListener('click', async () => {
    const fn = (window as unknown as { __ayushCopyEmail?: () => Promise<boolean> }).__ayushCopyEmail;
    const ok = fn ? await fn() : false;
    if (ok && copyLabel) {
      copyLabel.textContent = 'copied ✓';
      if (copyTimer) window.clearTimeout(copyTimer);
      copyTimer = window.setTimeout(() => {
        copyLabel.textContent = 'copy';
      }, 2200);
    }
  });

  // Work section accessible filter tabs
  const workTabs = document.querySelectorAll<HTMLButtonElement>('.work-tab');
  const ossCol = document.getElementById('workOssCol');
  const appCol = document.getElementById('workAppCol');

  workTabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.workTab;
      workTabs.forEach((b) => {
        const active = b === btn;
        b.setAttribute('aria-selected', active ? 'true' : 'false');
        b.className = active
          ? 'work-tab py-1.5 min-h-[38px] text-[var(--chapter-fg)] border-b-2 border-[var(--chapter-accent)] font-medium transition-colors cursor-pointer'
          : 'work-tab py-1.5 min-h-[38px] text-[var(--chapter-subtle)] border-b-2 border-transparent hover:text-[var(--chapter-fg)] transition-colors cursor-pointer';
      });

      if (ossCol && appCol) {
        const showOss = target === 'all' || target === 'oss';
        const showApp = target === 'all' || target === 'app';
        ossCol.classList.toggle('hidden', !showOss);
        appCol.classList.toggle('hidden', !showApp);

        ossCol.classList.toggle('md:col-span-12', target === 'oss');
        ossCol.classList.toggle('md:col-span-7', target !== 'oss');
        ossCol.classList.toggle('rule-chapter-r-md', target !== 'oss');
        ossCol.classList.toggle('md:pr-0', target === 'oss');
        ossCol.classList.toggle('md:pr-9', target !== 'oss');
        appCol.classList.toggle('md:col-span-12', target === 'app');
        appCol.classList.toggle('md:col-span-5', target !== 'app');
        appCol.classList.toggle('md:pl-0', target === 'app');
        appCol.classList.toggle('md:pl-9', target !== 'app');
      }
    });
  });
</script>
