---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LIVE_APPS, PROFILE, PUBLISHED_WRITING } from '../data/profile';
import {
  AFTER_HOURS_PCT,
  APP_SHOTS,
  COMMIT_HOURS,
  COMMIT_TOTAL,
  COMPETITIONS,
  PATH,
  SCORECARDS,
  WORK_CARDS,
} from '../data/oneday';
import { getWcaProfile } from '../lib/wca';

const wca = await getWcaProfile(PROFILE.wcaId);
const ev = (id: string) => wca.events.find((e) => e.id === id);
const pb333 = ev('333');
const records = [
  { color: 'var(--G)', big: pb333?.single ?? '10.86s', label: '3×3 single', small: `avg ${pb333?.average ?? '14.26s'}` },
  { color: 'var(--B)', big: (ev('333fm')?.single ?? '38 moves').replace(' moves', ''), label: 'Fewest moves', small: 'Delhi Open ’14' },
  { color: 'var(--R)', big: ev('333bf')?.single ?? '2:24.70', label: '3×3 Blindfolded', small: 'IIT Roorkee Open ’14' },
  { color: 'var(--Y)', big: ev('444')?.single ?? '41.91s', label: '4×4 single', small: 'Cerulean ’17 · silver' },
];
const medals = wca.medals;
const histMax = Math.max(...COMMIT_HOURS);
const hist = COMMIT_HOURS.map((n, h) => ({ h, n })).filter(({ h }) => h >= 8);
const pad = (h: number) => String(h).padStart(2, '0');
---

<BaseLayout bodyClass="oneday">
  <div class="sky" aria-hidden="true">
    <div class="stars" id="stars"></div>
    <div class="sun" id="sun"></div>
    <div class="moon" id="moon"></div>
  </div>

  <aside class="rail" aria-hidden="true">
    <div class="now" id="railNow">09:00</div>
    <div class="lbl" id="railLbl">IST · scroll to move the clock</div>
    <div class="hist" id="hist">
      {hist.map(({ h, n }) => (
        <div data-h={h}>
          <span>{pad(h)}</span>
          <b style={`width:${4 + (n / histMax) * 70}px`} />
        </div>
      ))}
    </div>
    <div class="lbl">my side-project<br />commits by hour</div>
  </aside>
  <div class="pill" aria-hidden="true"><i></i><span id="pillNow">09:00</span></div>

  <div class="w">
    <header class="top">
      <a class="name" href="/"><img src="/avatar.webp" alt="" width="30" height="30" />{PROFILE.name}</a>
      <nav class="links" aria-label="Primary">
        <a href="#work">Work</a>
        <a href="#cubing">Cubing</a>
        <a href="#builds">Builds</a>
        <a href="/writing">Writing</a>
        <a href={PROFILE.links.github} rel="noopener">GitHub</a>
      </nav>
    </header>

    <main id="main-content">
      <section data-h="9" id="top" class="first">
        <div class="stamp"><b>09:00</b> Bengaluru</div>
        <h1>One day with me.<br /><em>Work</em> until six, then everything else.</h1>
        <p class="lede">
          I'm Ayush, a Staff Software Engineer at Google. After hours I'm a speedcuber with {medals.total} WCA medals, and I
          build the apps my friends and I play with on game night.
        </p>
        <div class="scrollhint">↓ scroll to move the sun</div>
      </section>

      <section data-h="10.5" id="work">
        <div class="stamp"><b>10:30</b> At work</div>
        <h2>I build production AI and the platforms other engineers build it on.</h2>
        <p class="lede">Seven years at Amazon as a cross-team tech lead on Bedrock, Q Business and Rekognition. Now at Google.</p>
        <div class="grid2">
          {WORK_CARDS.map((c) => {
            const Tag = c.url ? 'a' : 'div';
            return (
              <Tag class="card" href={c.url} rel={c.url ? 'noopener' : undefined}>
                <div class="big">{c.big}</div>
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                <div class="meta">{c.meta}</div>
              </Tag>
            );
          })}
        </div>
      </section>

      <section data-h="14" id="experience">
        <div class="stamp"><b>14:00</b> The path here</div>
        <div class="rows">
          {PATH.map((r) => (
            <div class="row"><span>{r.when}</span><b>{r.where}</b><em>{r.what}</em></div>
          ))}
          {PUBLISHED_WRITING.map((w) => (
            <a class="row" href={w.url} rel="noopener"><span>{w.date}</span><b>{w.title.split(' (')[0]} ↗</b><em>{w.venue}</em></a>
          ))}
          <a class="row" href="/writing"><span>more</span><b>All writing →</b><em>/writing</em></a>
        </div>
      </section>

      <section data-h="18.25" class="sunset">
        <div class="stamp"><b>18:15</b> Logging off</div>
        <h2>The laptop closes.<br />The <em>cube</em> comes out.</h2>
        <p class="lede">
          {AFTER_HOURS_PCT}% of my {COMMIT_TOTAL} side-project commits land before 9am or after 6pm. Everything below is what
          happens in those hours.
        </p>
      </section>

      <section data-h="20.5" id="cubing">
        <div class="stamp"><b>20:30</b> Speedcubing · <a href={PROFILE.links.wca} rel="noopener">WCA {PROFILE.wcaId} ↗</a></div>
        <div class="intro">
          <div class="cards" role="img" aria-label="Two of my WCA scorecards: 3×3 Blindfolded 2:24.70 silver at IIT Roorkee Open 2014, and 4×4 41.91 silver at Cerulean 2017">
            {SCORECARDS.map((sc, i) => (
              <div class:list={['sc', i === 0 ? 'back' : 'front']} aria-hidden="true">
                <div class="hd">{sc.comp}</div>
                <div class="ev">{sc.event}</div>
                <table>
                  {sc.attempts.map((a, j) => (
                    <tr class:list={[{ pb: j === sc.best }]}><td>{j + 1}</td><td>attempt</td><td>{a}</td></tr>
                  ))}
                </table>
                <div class="ft"><span set:html={sc.foot.replace(/([\d.]+)/, '<b>$1</b>')} /><span>place <b>{sc.place}</b></span></div>
                <div class="stamp2">SILVER</div>
              </div>
            ))}
          </div>
          <div>
            <h2 class="h2s">Fourteen puzzles, a blindfold, and a notebook full of move counts.</h2>
            <p>
              My first official competition was Delhi Open 2014. I came home with a silver in Fewest Moves, and a month later
              won five medals at IIT Roorkee Open.
            </p>
            <p>
              The slow, thinky events are still my favourite. These are two real scorecards: a 2:24.70 blindfolded silver,
              and the 41.91 that’s still my 4×4 best.
            </p>
          </div>
        </div>
        <div class="records">
          {records.map((r) => (
            <div class="rec" style={`--c:${r.color}`}><b>{r.big}</b><span>{r.label}</span><small>{r.small}</small></div>
          ))}
        </div>
        <div class="strip">
          {COMPETITIONS.map((c) => (
            <div class="col" title={`${c.name} · ${c.city}`}>
              <div class="yr">{c.short}<br />{c.year}</div>
              <div class="pip"></div>
              {c.medals.length ? (
                c.medals.map(([k, t]) => <span class:list={['m', k]} tabindex="0" data-t={t} aria-label={`${c.name}: ${t}`} />)
              ) : (
                <span class="none" aria-label={`${c.name}: no medal`} />
              )}
            </div>
          ))}
        </div>
        <div class="stripnote">
          Every competition, 2014–2017 · {medals.total} medals ({medals.silver} silver, {medals.bronze} bronze) · hover a medal
        </div>
        <details class="all">
          <summary>All {wca.events.length} personal bests</summary>
          <table class="pbt">
            <tr><th>Event</th><th>Single</th><th>Average</th></tr>
            {wca.events.map((e) => <tr><td>{e.name}</td><td>{e.single}</td><td>{e.average}</td></tr>)}
          </table>
        </details>
      </section>

      <section data-h="22.5" id="builds">
        <div class="stamp"><b>22:30</b> Game night</div>
        <h2>When friends come over, the phone on the table is usually running something I built.</h2>
        <p class="lede">One game you play, two scorekeepers for games we already own. No logins, phone first.</p>
        <div class="apps">
          {LIVE_APPS.map((app) => (
            <a class="app" href={app.url} rel="noopener">
              <div class="phone">
                <img src={APP_SHOTS[app.url]} alt={`${app.title} on a phone`} loading="lazy" width="300" height="569" />
              </div>
              <h3>{app.title}</h3>
              <p>{app.description}</p>
              <span class="st">● {new URL(app.url).host.replace('.vercel.app', '')} ↗</span>
            </a>
          ))}
        </div>
      </section>

      <section data-h="23.75" class="end" id="contact">
        <div class="stamp"><b>23:45</b> Say hi</div>
        <h2>Building something with AI,<br />or short a player for game night?</h2>
        <div>
          <a class="btn" href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>
          <a class="btn ghost" href={PROFILE.links.linkedin} rel="noopener">LinkedIn ↗</a>
        </div>
      </section>
    </main>
    <footer class="foot">
      <span>© {new Date().getFullYear()} {PROFILE.name} · Bengaluru</span>
      <span id="real"></span>
    </footer>
  </div>
</BaseLayout>

<style is:global>
  body.oneday {
    --bg: #f6f3ec;
    --fg: #1a1916;
    --accent: #b4430b;
    --muted: color-mix(in srgb, var(--fg) 68%, var(--bg));
    --faint: color-mix(in srgb, var(--fg) 52%, var(--bg));
    --rule: color-mix(in srgb, var(--fg) 13%, var(--bg));
    --card: color-mix(in srgb, var(--fg) 4%, var(--bg));
    --G: #3ddc84; --B: #4d8dff; --R: #ff5a4e; --Y: #ffd23f; --silver: #c3c8d2; --bronze: #cf8a4e;
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: 16px/1.6 var(--font-sans);
    overflow-x: clip;
  }
  html:has(body.oneday) { background: var(--bg); }
  .oneday a { color: inherit; text-decoration: none; }
  .oneday .w { max-width: 940px; margin: 0 auto; padding: 0 32px; position: relative; z-index: 2; }

  .oneday .sky { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
  .oneday .sun, .oneday .moon { position: absolute; right: 9vw; border-radius: 50%; will-change: transform; }
  .oneday .sun { width: 120px; height: 120px; background: radial-gradient(circle, #ffe08a 0 40%, #ffb347 70%, transparent 71%); box-shadow: 0 0 120px 40px rgba(255, 170, 70, 0.25); }
  .oneday .moon { width: 84px; height: 84px; transform: translateY(120vh); background: radial-gradient(circle at 35% 35%, #fbfbf4, #d9dccf 60%); box-shadow: 0 0 60px 10px rgba(220, 225, 255, 0.12); }
  .oneday .moon::after { content: ''; position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle at 70% 60%, rgba(0, 0, 0, 0.08) 0 10%, transparent 11%), radial-gradient(circle at 40% 70%, rgba(0, 0, 0, 0.07) 0 7%, transparent 8%); }
  .oneday .stars { position: absolute; inset: 0; opacity: 0; }
  .oneday .stars i { position: absolute; width: 2px; height: 2px; border-radius: 50%; background: #fff; }

  .oneday .rail { position: fixed; left: 28px; top: 50%; transform: translateY(-50%); z-index: 3; display: flex; flex-direction: column; gap: 10px; }
  .oneday .rail .now { font: 600 22px var(--font-mono); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .oneday .rail .lbl { font: 12px/1.4 var(--font-mono); color: var(--faint); max-width: 120px; }
  .oneday .hist { display: flex; flex-direction: column; gap: 3px; margin-top: 6px; }
  .oneday .hist div { display: flex; align-items: center; gap: 6px; height: 7px; font: 10px/1 var(--font-mono); color: var(--faint); }
  .oneday .hist span { width: 16px; }
  .oneday .hist b { display: block; height: 5px; border-radius: 3px; background: var(--rule); }
  .oneday .hist div.on b { background: var(--accent); }
  .oneday .hist div.on { color: var(--fg); }
  .oneday .pill { display: none; position: fixed; top: 14px; right: 14px; z-index: 4; align-items: center; gap: 8px; padding: 7px 12px; border-radius: 999px; background: var(--card); box-shadow: 0 0 0 1px var(--rule); font: 600 13px var(--font-mono); backdrop-filter: blur(8px); }
  .oneday .pill i { width: 9px; height: 9px; border-radius: 50%; background: var(--accent); }

  .oneday header.top { display: flex; justify-content: space-between; align-items: center; height: 76px; }
  .oneday .name { display: flex; align-items: center; gap: 10px; font-weight: 650; }
  .oneday .name img { width: 30px; height: 30px; border-radius: 50%; }
  .oneday .links { display: flex; gap: 20px; font-size: 14px; color: var(--muted); }
  .oneday .links a:hover { color: var(--fg); }

  .oneday section { padding: 12vh 0 6vh; scroll-margin-top: 0; }
  .oneday section.first { padding-top: 8vh; }
  .oneday .stamp { font: 500 12.5px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--faint); display: flex; gap: 14px; align-items: center; margin-bottom: 22px; }
  .oneday .stamp b { color: var(--accent); font-weight: 600; letter-spacing: 0; font-size: 14px; }
  .oneday .stamp a:hover { color: var(--fg); }
  .oneday .stamp::after { content: ''; flex: 1; height: 1px; background: var(--rule); }
  .oneday h1 { font: 400 clamp(44px, 7vw, 84px)/0.98 var(--font-serif); letter-spacing: -0.035em; margin: 0 0 26px; }
  .oneday h2 { font: 400 clamp(32px, 4.6vw, 52px)/1.04 var(--font-serif); letter-spacing: -0.03em; margin: 0 0 18px; }
  .oneday h2.h2s { font-size: clamp(28px, 3.6vw, 40px); }
  .oneday h1 em, .oneday h2 em { color: var(--accent); font-style: italic; }
  .oneday .lede { font-size: 19px; color: var(--muted); max-width: 56ch; margin: 0; }
  .oneday .scrollhint { margin-top: 48px; font: 13px var(--font-mono); color: var(--faint); }
  .oneday .sunset h2 { font-size: clamp(40px, 6vw, 72px); }

  .oneday .grid2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin-top: 28px; }
  .oneday .card { background: var(--card); border: 1px solid var(--rule); border-radius: 16px; padding: 22px; display: block; transition: transform 0.25s; }
  .oneday a.card:hover { transform: translateY(-3px); }
  .oneday .card .big { font: 400 44px/1 var(--font-serif); letter-spacing: -0.03em; margin-bottom: 12px; }
  .oneday .card h3 { margin: 0 0 4px; font-size: 17px; font-weight: 600; }
  .oneday .card p { margin: 0; color: var(--muted); font-size: 14.5px; }
  .oneday .card .meta { margin-top: 12px; font: 12px var(--font-mono); color: var(--faint); }
  .oneday .rows { border-top: 1px solid var(--rule); }
  .oneday .row { display: grid; grid-template-columns: 110px 1fr auto; gap: 20px; padding: 15px 0; border-bottom: 1px solid var(--rule); align-items: baseline; }
  .oneday .row span { font: 13px var(--font-mono); color: var(--faint); }
  .oneday .row b { font-weight: 600; }
  .oneday .row em { font-style: normal; color: var(--muted); }
  .oneday a.row:hover b { color: var(--accent); }

  .oneday .intro { display: grid; grid-template-columns: 470px 1fr; gap: 44px; align-items: center; margin-top: 10px; }
  .oneday .intro p { color: var(--muted); margin: 0 0 12px; }
  .oneday .cards { position: relative; height: 300px; }
  .oneday .sc { position: absolute; width: 228px; background: #fbf8f0; color: #23211c; border-radius: 6px; padding: 14px 16px 12px; font: 12px/1.35 var(--font-mono); box-shadow: 0 24px 50px -18px rgba(0, 0, 0, 0.65); transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .oneday .sc.back { left: 0; top: 28px; transform: rotate(-5deg); z-index: 1; }
  .oneday .sc.front { left: 232px; top: 6px; transform: rotate(4deg); }
  .oneday .cards:hover .sc.back { transform: rotate(-2deg) translateY(-6px); }
  .oneday .cards:hover .sc.front { transform: rotate(1deg) translateY(-6px); }
  .oneday .sc .hd { border-bottom: 1.5px solid #23211c; padding-bottom: 6px; margin-bottom: 6px; font-weight: 700; letter-spacing: 0.02em; }
  .oneday .sc .ev { font: italic 600 17px var(--font-serif); margin: 2px 0 8px; }
  .oneday .sc table { width: 100%; border-collapse: collapse; }
  .oneday .sc td { border: 1px solid #cfc8b8; padding: 4px 7px; }
  .oneday .sc td:first-child { width: 26px; text-align: center; color: #6b665c; }
  .oneday .sc td:last-child { text-align: right; font-weight: 600; }
  .oneday .sc tr.pb td:last-child { position: relative; color: #b4300b; }
  .oneday .sc tr.pb td:last-child::after { content: ''; position: absolute; inset: 1px 2px; border: 2px solid #c8361a; border-radius: 50%; transform: rotate(-4deg); }
  .oneday .sc .ft { display: flex; justify-content: space-between; margin-top: 8px; color: #6b665c; }
  .oneday .sc .ft b { color: #23211c; }
  .oneday .sc .stamp2 { position: absolute; right: -14px; top: -16px; background: #fbf8f0; font: 700 11px var(--font-mono); color: #7d8796; border: 2px solid #9aa3b1; border-radius: 50%; width: 54px; height: 54px; display: grid; place-items: center; transform: rotate(-14deg); }

  .oneday .records { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 34px; }
  .oneday .rec { border-radius: 14px; padding: 16px; background: var(--card); border: 1px solid var(--rule); position: relative; overflow: hidden; }
  .oneday .rec::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--c); }
  .oneday .rec b { display: block; font: 700 23px/1.1 var(--font-mono); letter-spacing: -0.02em; }
  .oneday .rec span { font-size: 13px; color: var(--muted); }
  .oneday .rec small { display: block; font: 12px var(--font-mono); color: var(--faint); margin-top: 6px; }

  .oneday .strip { display: grid; grid-template-columns: repeat(8, 1fr); gap: 8px; margin-top: 30px; align-items: end; }
  .oneday .col { display: flex; flex-direction: column-reverse; align-items: center; gap: 6px; }
  .oneday .col .yr { font: 12px/1.3 var(--font-mono); color: var(--faint); margin-top: 6px; text-align: center; }
  .oneday .col .m { width: 26px; height: 26px; border-radius: 50%; background: var(--mc); box-shadow: inset 0 -3px 0 rgba(0, 0, 0, 0.25), inset 0 2px 0 rgba(255, 255, 255, 0.4); position: relative; }
  .oneday .col .m.s { --mc: var(--silver); }
  .oneday .col .m.b { --mc: var(--bronze); }
  .oneday .col .m:hover::after, .oneday .col .m:focus-visible::after { content: attr(data-t); position: absolute; bottom: 34px; left: 50%; transform: translateX(-50%); white-space: nowrap; font: 12px var(--font-mono); background: var(--fg); color: var(--bg); padding: 4px 8px; border-radius: 6px; z-index: 5; }
  .oneday .col .none { width: 26px; height: 26px; border-radius: 50%; border: 1.5px dashed var(--rule); }
  .oneday .col .pip { width: 1px; height: 18px; background: var(--rule); }
  .oneday .stripnote { font: 12.5px var(--font-mono); color: var(--faint); margin-top: 16px; }
  .oneday details.all { margin-top: 18px; }
  .oneday details.all summary { cursor: pointer; font: 13px var(--font-mono); color: var(--muted); list-style: none; padding: 10px 0; }
  .oneday details.all summary::-webkit-details-marker { display: none; }
  .oneday details.all summary::before { content: '+ '; }
  .oneday details.all[open] summary::before { content: '− '; }
  .oneday .pbt { width: 100%; border-collapse: collapse; font: 13.5px var(--font-mono); }
  .oneday .pbt th { text-align: left; font-weight: 400; color: var(--faint); padding: 9px 0; border-bottom: 1px solid var(--rule); }
  .oneday .pbt td { padding: 9px 0; border-bottom: 1px solid var(--rule); }
  .oneday .pbt th:not(:first-child), .oneday .pbt td:not(:first-child) { text-align: right; }
  .oneday .pbt td:not(:first-child) { color: var(--muted); }

  .oneday .apps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; margin-top: 30px; }
  .oneday .phone { background: #050608; border-radius: 30px; padding: 9px; box-shadow: 0 0 0 1px #2a2f3b, 0 30px 50px -24px rgba(0, 0, 0, 0.8); position: relative; transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .oneday .phone::before { content: ''; position: absolute; top: 15px; left: 50%; width: 54px; height: 15px; margin-left: -27px; border-radius: 10px; background: #050608; z-index: 1; }
  .oneday .phone img { display: block; width: 100%; height: auto; aspect-ratio: 300 / 569; object-fit: cover; object-position: top; border-radius: 22px; }
  .oneday .app:hover .phone { transform: translateY(-6px) rotate(-1deg); }
  .oneday .app h3 { margin: 18px 0 2px; font-size: 16.5px; font-weight: 600; }
  .oneday .app p { margin: 0; font-size: 14px; color: var(--muted); }
  .oneday .app .st { display: block; font: 12px var(--font-mono); color: var(--G); margin-top: 8px; }

  .oneday .end { min-height: 70vh; display: flex; flex-direction: column; justify-content: center; }
  .oneday .btn { display: inline-block; margin-top: 18px; padding: 13px 20px; border-radius: 999px; background: var(--fg); color: var(--bg); font-weight: 600; }
  .oneday .btn.ghost { background: transparent; color: var(--fg); box-shadow: inset 0 0 0 1px var(--rule); margin-left: 8px; }
  .oneday .foot { padding: 24px 0 48px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; font: 12.5px var(--font-mono); color: var(--faint); }

  @media (max-width: 1180px) {
    .oneday .rail { display: none; }
    .oneday .pill { display: flex; }
  }
  @media (max-width: 800px) {
    .oneday .sky { opacity: 0.55; }
    .oneday .w { padding: 0 20px; }
    .oneday .links { display: none; }
    .oneday section { padding: 9vh 0 4vh; }
    .oneday .grid2, .oneday .apps { grid-template-columns: 1fr; }
    .oneday .apps { gap: 40px; }
    .oneday .phone { max-width: 270px; margin: 0 auto; }
    .oneday .intro { grid-template-columns: 1fr; gap: 28px; }
    .oneday .cards { height: auto; display: grid; gap: 22px; justify-items: center; }
    .oneday .sc, .oneday .sc.back, .oneday .sc.front { position: relative; left: auto; top: auto; width: 270px; }
    .oneday .records { grid-template-columns: repeat(2, 1fr); }
    .oneday .row { grid-template-columns: 1fr; gap: 2px; }
    .oneday .strip { grid-template-columns: repeat(4, 1fr); row-gap: 22px; }
    .oneday .sun { width: 80px; height: 80px; right: 6vw; }
    .oneday .moon { width: 60px; height: 60px; right: 8vw; }
  }
  @media (prefers-reduced-motion: reduce) {
    .oneday * { transition: none !important; }
  }
</style>

<script>
  const root = document.body;
  const stars = document.getElementById('stars')!;
  for (let i = 0; i < 90; i++) {
    const s = document.createElement('i');
    s.style.left = Math.random() * 100 + '%';
    s.style.top = Math.random() * 70 + '%';
    s.style.opacity = String(0.2 + Math.random() * 0.6);
    stars.appendChild(s);
  }

  // Sky palette keyed by hour of the "day" the page represents.
  const STOPS: [number, string, string, string][] = [
    [9, '#f6f3ec', '#1a1916', '#b4430b'],
    [15, '#f6eedf', '#1d1914', '#b4430b'],
    [17.4, '#f6d6a8', '#2a1a0e', '#a8350a'],
    [18.4, '#e98a63', '#24110a', '#5a1608'],
    [19.4, '#4b2f57', '#f6eef6', '#ffb36b'],
    [20.4, '#0e1220', '#eef0f5', '#ffd23f'],
    [24, '#090b11', '#eef0f5', '#ffd23f'],
  ];
  const hex = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
  const mix = (a: string, b: string, t: number) => {
    const A = hex(a), B = hex(b);
    return 'rgb(' + A.map((v, i) => Math.round(v + (B[i] - v) * t)).join(',') + ')';
  };
  function palette(h: number) {
    let i = 0;
    while (i < STOPS.length - 2 && h > STOPS[i + 1][0]) i++;
    const [h0, ...A] = STOPS[i];
    const [h1, ...B] = STOPS[i + 1];
    const t = Math.min(1, Math.max(0, (h - h0) / (h1 - h0)));
    return A.map((c, k) => mix(c, B[k], t));
  }

  const secs = [...document.querySelectorAll<HTMLElement>('section[data-h]')];
  const sun = document.getElementById('sun')!;
  const moon = document.getElementById('moon')!;
  const railNow = document.getElementById('railNow')!;
  const railLbl = document.getElementById('railLbl')!;
  const pillNow = document.getElementById('pillNow')!;
  const hist = [...document.querySelectorAll<HTMLElement>('#hist > div')];
  const themeMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const fmt = (h: number) =>
    `${String(Math.floor(h) % 24).padStart(2, '0')}:${String(Math.floor((h % 1) * 60)).padStart(2, '0')}`;

  function hourAt() {
    const y = scrollY + innerHeight * 0.45;
    const tops = secs.map((s) => s.offsetTop);
    const hs = secs.map((s) => Number(s.dataset.h));
    if (y <= tops[0]) return hs[0];
    for (let i = 0; i < secs.length - 1; i++) {
      if (y < tops[i + 1]) return hs[i] + ((y - tops[i]) / (tops[i + 1] - tops[i])) * (hs[i + 1] - hs[i]);
    }
    return hs[hs.length - 1];
  }

  let raf = 0;
  function paint() {
    raf = 0;
    const h = hourAt();
    const [bg, fg, ac] = palette(h);
    root.style.setProperty('--bg', bg);
    root.style.setProperty('--fg', fg);
    root.style.setProperty('--accent', ac);
    document.documentElement.style.backgroundColor = bg;
    themeMeta?.setAttribute('content', bg);
    const vh = innerHeight;
    const sp = Math.min(1, Math.max(0, (h - 9) / 10));
    sun.style.transform = `translateY(${vh * (0.1 + sp)}px)`;
    sun.style.opacity = h > 19.2 ? '0' : '1';
    sun.style.filter = `hue-rotate(${-sp * 25}deg) saturate(${1 + sp})`;
    const mp = Math.min(1, Math.max(0, (h - 19) / 3));
    moon.style.transform = `translateY(${vh * (1.1 - mp * 0.95)}px)`;
    stars.style.opacity = String(Math.min(1, Math.max(0, (h - 19) / 1.5)));
    railNow.textContent = pillNow.textContent = fmt(h);
    railLbl.textContent = h < 18 ? 'IST · at work' : h < 19 ? 'IST · logging off' : 'IST · off the clock';
    hist.forEach((d) => d.classList.toggle('on', Number(d.dataset.h) === Math.floor(h)));
  }
  addEventListener('scroll', () => { raf ||= requestAnimationFrame(paint); }, { passive: true });
  addEventListener('resize', paint);
  paint();

  const t = new Date().toLocaleTimeString('en-IN', { timeZone: 'Asia/Kolkata', hour: '2-digit', minute: '2-digit', hour12: false });
  document.getElementById('real')!.textContent = `really ${t} in Bengaluru right now`;
</script>
