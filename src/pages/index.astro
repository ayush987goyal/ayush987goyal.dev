---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CommandPalette from '../components/CommandPalette.astro';
import WcaSection from '../components/WcaSection.astro';
import {
  AMAZON_TENURE,
  CURRENT_ROLE,
  EARLY_FOUNDATIONS,
  FEATURED_OSS,
  LIVE_APPS,
  PROFILE,
  UPSTREAM_OSS,
} from '../data/profile';
import { getWcaProfile } from '../lib/wca';

const wca = await getWcaProfile(PROFILE.wcaId);
const publishedPosts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
---

<BaseLayout>
  <SiteHeader active="home" />

  <main id="main-content" class="flex-1">
    <!-- =================================================================== -->
    <!-- CHAPTER I: WARM LITERARY PAPER HERO + UNIFIED CAREER LEDGER         -->
    <!-- =================================================================== -->
    <div id="top" class="max-w-5xl mx-auto px-5 sm:px-10 pt-10 sm:pt-14 pb-14 sm:pb-16 space-y-12">
      <!-- Editorial Hero Spread -->
      <section class="grid grid-cols-1 md:grid-cols-12 gap-8 items-end">
        <div class="md:col-span-9 space-y-5">
          <p class="font-mono text-xs uppercase tracking-[0.14em] text-[var(--accent)]">
            {PROFILE.role} · {PROFILE.location}
          </p>

          <h1 class="font-editorial font-normal text-[38px] sm:text-[54px] lg:text-[62px] leading-[1.01] tracking-[-0.03em] text-[var(--fg)]">
            Shipping <em class="italic">production AI</em>,{' '}<br class="hidden sm:inline" />from inference pipelines{' '}<br class="hidden sm:inline" />to developer platforms.
          </h1>

          <p class="text-[16px] sm:text-[17px] leading-[1.64] text-[var(--fg-muted)] max-w-[62ch]">
            I'm <strong class="font-medium text-[var(--fg)]">{PROFILE.name}</strong>, a Staff Software Engineer at
            <strong class="font-medium text-[var(--fg)]"> Google</strong>. Over{' '}
            <span class="editorial-mark font-medium text-[var(--fg)]">10+ years</span> — including seven at Amazon as cross-team technical lead across 10–25 engineers on AWS Bedrock, Q Business, and Rekognition — I've launched GA multimodal AI platforms, real-time ML inference pipelines,{' '}
            <a
              href={PROFILE.links.awsMcpPrs}
              target="_blank"
              rel="noopener"
              class="editorial-link text-[var(--fg)]"
            >
              two official AWSLabs MCP servers ↗
            </a>,{' '}
            <a
              href={PROFILE.links.awsCdkPrs}
              target="_blank"
              rel="noopener"
              class="editorial-link text-[var(--fg)]"
            >
              46 merged AWS CDK PRs ↗
            </a>, and an{' '}
            <a
              href={PROFILE.links.awsMlBlog}
              target="_blank"
              rel="noopener"
              class="editorial-link text-[var(--fg)]"
            >
              AWS ML Blog walkthrough ↗
            </a>.
          </p>

          <!-- Hairline Underlined Action Links (Generous mobile touch targets) -->
          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 pt-1 text-[14px]">
            <span class="inline-flex items-baseline gap-2.5 py-1.5">
              <a
                href={`mailto:${PROFILE.email}`}
                class="text-[var(--fg)] font-medium underline decoration-[var(--accent)] underline-offset-4 decoration-1 hover:text-[var(--accent)] transition-colors"
              >
                {PROFILE.email}
              </a>
              <button
                id="copyEmailBtn"
                type="button"
                aria-label={`Copy ${PROFILE.email} to clipboard`}
                class="font-mono text-xs px-2 py-0.5 border border-[var(--border)] text-[var(--fg-subtle)] hover:text-[var(--fg)] hover:border-[var(--border-strong)] transition-colors cursor-pointer"
              >
                <span id="copyEmailLabel">copy</span>
              </button>
            </span>
            <a href={PROFILE.links.github} target="_blank" rel="noopener" class="editorial-link py-1.5 text-[var(--fg-muted)]">
              GitHub ↗
            </a>
            <a href={PROFILE.links.linkedin} target="_blank" rel="noopener" class="editorial-link py-1.5 text-[var(--fg-muted)]">
              LinkedIn ↗
            </a>
            <a href={PROFILE.links.wca} target="_blank" rel="noopener" class="editorial-link py-1.5 text-[var(--fg-muted)]">
              WCA {PROFILE.wcaId} ↗
            </a>
          </div>
        </div>

        <!-- Editorial Portrait Stamp (Native 250x250 WebP/JPG crop, real metadata) -->
        <div class="md:col-span-3 flex md:flex-col items-center md:items-end justify-start gap-4">
          <figure class="w-32 sm:w-36 p-1.5 border border-[var(--border-strong)] bg-[var(--surface)] shrink-0">
            <div class="w-full aspect-square overflow-hidden bg-[var(--chapter-bg)] relative">
              <picture>
                <source srcset="/avatar.webp" type="image/webp" />
                <img
                  src="/avatar.jpg"
                  alt={PROFILE.name}
                  width="250"
                  height="250"
                  loading="eager"
                  decoding="async"
                  class="w-full h-full object-cover portrait-stamp"
                />
              </picture>
            </div>
            <figcaption class="mt-1.5 font-mono text-xs uppercase tracking-[0.1em] text-center text-[var(--fg-subtle)]">
              {PROFILE.coordinates}
            </figcaption>
          </figure>

          <div class="md:w-44 text-left md:text-right font-mono text-xs text-[var(--fg-subtle)] leading-snug space-y-0.5">
            <div class="text-[var(--fg)]">IIT Roorkee · 2nd/110</div>
            <div>AWS ML Blog Author</div>
            <div>{wca.medals.total} WCA Medals</div>
          </div>
        </div>
      </section>

      <!-- Hand-drawn Editorial Squiggle Divider -->
      <div class="flex items-center gap-4 text-[var(--accent)]/85 pt-1">
        <svg width="108" height="10" viewBox="0 0 108 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="shrink-0">
          <path
            d="M1 5.5C9 1.5 16 9.5 24 5.5C32 1.5 39 9.5 47 5.5C55 1.5 62 9.5 70 5.5C78 1.5 85 9.5 93 5.5C100 2 104 7 107 5"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linecap="round"
          />
        </svg>
        <span class="font-mono text-xs uppercase tracking-[0.14em] text-[var(--fg-subtle)]">
          Career · 2012–2026
        </span>
      </div>

      <!-- Unified, Zero-Duplication Career Ledger -->
      <section id="experience" class="space-y-0">
        <!-- Row 1: Google (Current) -->
        <article class="pb-6 grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-8 items-baseline rule-dotted-b">
          <div class="md:col-span-3 space-y-0.5">
            <div class="font-mono text-xs uppercase tracking-[0.1em] text-[var(--accent)]">
              {CURRENT_ROLE.period}
            </div>
            <div class="font-mono text-xs text-[var(--fg-subtle)]">{CURRENT_ROLE.location}</div>
          </div>
          <div class="md:col-span-9">
            <div class="flex flex-wrap items-baseline gap-x-2.5">
              <h2 class="font-editorial font-normal text-[28px] leading-tight text-[var(--fg)]">
                {CURRENT_ROLE.company}
              </h2>
              <span class="font-editorial italic text-[17px] text-[var(--fg-subtle)]">
                — {CURRENT_ROLE.title}
              </span>
            </div>
          </div>
        </article>

        <!-- Row 2: Amazon & AWS (7 Years · Selected Launches & Measured Impact) -->
        <article class="py-7 grid grid-cols-1 md:grid-cols-12 gap-3 md:gap-8 rule-dotted-b">
          <div class="md:col-span-3 space-y-0.5">
            <div class="font-mono text-xs uppercase tracking-[0.08em] text-[var(--fg-subtle)]">
              {AMAZON_TENURE.period}
            </div>
            <div class="font-mono text-xs text-[var(--fg-subtle)]">{AMAZON_TENURE.location}</div>
          </div>

          <div class="md:col-span-9 space-y-5">
            <div class="space-y-1.5">
              <div class="flex flex-wrap items-baseline gap-x-2.5">
                <h2 class="font-editorial font-normal text-[28px] leading-tight text-[var(--fg)]">
                  {AMAZON_TENURE.company}
                </h2>
                <span class="font-editorial italic text-[16px] text-[var(--fg-subtle)]">
                  — {AMAZON_TENURE.progression}
                </span>
              </div>
              <p class="text-[14.5px] leading-[1.62] text-[var(--fg-muted)] max-w-[66ch]">
                {AMAZON_TENURE.scope}
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-7 gap-y-5 pt-1">
              {
                AMAZON_TENURE.highlights.map((item) => (
                  <div class="border-l border-dotted border-[var(--border-dotted)] pl-4 space-y-1">
                    <div class="flex flex-wrap items-baseline justify-between gap-x-2 gap-y-0.5">
                      <h3 class="text-[14.5px] font-medium text-[var(--fg)]">{item.product}</h3>
                    </div>
                    {item.metric && (
                      <div class="font-mono text-xs text-[var(--accent)]">{item.metric}</div>
                    )}
                    <p class="text-[13.5px] leading-[1.58] text-[var(--fg-muted)]">{item.summary}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </article>

        <!-- Row 3: Earlier Foundations (3-Column Print Strip — Goldman Sachs, Citibank, IIT Roorkee) -->
        <div class="pt-7 grid grid-cols-1 md:grid-cols-3 gap-7 md:gap-0">
          {
            EARLY_FOUNDATIONS.map((item, idx) => (
              <article
                class:list={[
                  'space-y-1.5',
                  idx === 0 && 'md:pr-7 rule-dotted-r-md pb-6 md:pb-0 rule-dotted-b-mobile',
                  idx === 1 && 'md:px-7 rule-dotted-r-md pb-6 md:pb-0 rule-dotted-b-mobile',
                  idx === 2 && 'md:pl-7',
                ]}
              >
                <div class="font-mono text-xs text-[var(--fg-subtle)]">{item.period}</div>
                <div class="flex flex-wrap items-baseline gap-x-2">
                  <h3 class="font-editorial font-normal text-[23px] leading-tight text-[var(--fg)]">
                    {item.org}
                  </h3>
                </div>
                <div class="font-mono text-xs text-[var(--accent)]">{item.role}</div>
                <p class="text-[13.5px] leading-[1.6] text-[var(--fg-muted)]">{item.summary}</p>
              </article>
            ))
          }
        </div>
      </section>
    </div>

    <!-- =================================================================== -->
    <!-- CHAPTER II: DEEP ESPRESSO EDITORIAL CHAPTER (Rebalanced 2-Tier)     -->
    <!-- =================================================================== -->
    <section
      id="work"
      class="chapter-band bg-[var(--chapter-bg)] text-[var(--chapter-fg)] rule-chapter-t rule-chapter-b"
    >
      <div class="max-w-5xl mx-auto px-5 sm:px-10 py-14 sm:py-16 space-y-9">
        <!-- Chapter Masthead & Accessible Filter Tabs -->
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 rule-chapter-b pb-5">
          <div class="space-y-1.5">
            <div class="font-mono text-xs uppercase tracking-[0.14em] text-[var(--chapter-accent)]">
              Index · Open Source &amp; Builds
            </div>
            <h2 class="font-editorial font-normal text-3xl sm:text-[42px] leading-[1.05] tracking-[-0.025em] text-[var(--chapter-fg)]">
              Things shipped in the <em class="italic text-[var(--chapter-accent)]">open</em>.
            </h2>
          </div>

          <div role="tablist" aria-label="Filter projects by category" class="flex items-center gap-5 text-xs font-mono">
            <button
              type="button"
              role="tab"
              aria-selected="true"
              aria-controls="workContainer"
              data-work-tab="all"
              class="work-tab py-1.5 min-h-[38px] text-[var(--chapter-fg)] border-b-2 border-[var(--chapter-accent)] font-medium transition-colors cursor-pointer"
            >
              All
            </button>
            <button
              type="button"
              role="tab"
              aria-selected="false"
              aria-controls="workOssSection"
              data-work-tab="oss"
              class="work-tab py-1.5 min-h-[38px] text-[var(--chapter-subtle)] border-b-2 border-transparent hover:text-[var(--chapter-fg)] transition-colors cursor-pointer"
            >
              Open Source
            </button>
            <button
              type="button"
              role="tab"
              aria-selected="false"
              aria-controls="workAppSection"
              data-work-tab="app"
              class="work-tab py-1.5 min-h-[38px] text-[var(--chapter-subtle)] border-b-2 border-transparent hover:text-[var(--chapter-fg)] transition-colors cursor-pointer"
            >
              Weekend Builds
            </button>
          </div>
        </div>

        <div id="workContainer" class="space-y-9">
          <!-- Primary Tier: Balanced 2-Column Flagship Open Source + 3-Column Upstream Strip -->
          <div id="workOssSection" class="space-y-9 rule-chapter-b pb-9">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-0 rule-chapter-b pb-9">
              {
                FEATURED_OSS.map((feat, idx) => (
                  <article
                    class:list={[
                      'space-y-4 flex flex-col justify-between',
                      idx === 0 && 'md:pr-9 rule-chapter-r-md pb-8 md:pb-0 rule-chapter-b-mobile',
                      idx === 1 && 'md:pl-9',
                    ]}
                  >
                    <div class="space-y-3.5">
                      <div class="font-mono text-xs uppercase tracking-[0.12em] text-[var(--chapter-accent)]">
                        {feat.eyebrow}
                      </div>

                      <h3 class="font-editorial font-normal text-[28px] sm:text-[32px] leading-[1.1] tracking-[-0.02em] text-[var(--chapter-fg)]">
                        {feat.title} <em class="italic text-[#dfd6c9]">{feat.titleAccent}</em> {feat.titleTail}
                      </h3>

                      <p class="text-[14px] leading-[1.66] text-[var(--chapter-muted)]">
                        {feat.description}
                      </p>

                      <div class="bg-[var(--chapter-surface)] border border-[var(--chapter-rule)] px-3.5 py-2.5 font-mono text-xs text-[#dfd8cd]">
                        {feat.specLine}
                      </div>
                    </div>

                    <!-- Inline Editorial Arrows -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-5 gap-y-2 pt-2 font-mono text-xs">
                      {feat.links.map((item) => (
                        <a
                          href={item.url}
                          target="_blank"
                          rel="noopener"
                          class="inline-flex items-baseline gap-1.5 py-1.5 text-[var(--chapter-accent)] border-b border-dotted border-[var(--chapter-rule)] hover:text-[var(--chapter-fg)] hover:border-[var(--chapter-accent)] transition-colors"
                        >
                          <span>{item.label}</span>
                          <span class="shrink-0" aria-hidden="true">↗</span>
                        </a>
                      ))}
                    </div>
                  </article>
                ))
              }
            </div>

            <!-- Selected Upstream OSS Contributions -->
            <div class="space-y-5">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <div class="font-mono text-xs uppercase tracking-[0.14em] text-[var(--chapter-accent)]">
                  Upstream Open Source · 92 Merged External PRs
                </div>
                <div class="font-mono text-xs text-[var(--chapter-subtle)]">
                  Core AWS SDKs, React &amp; Vue ecosystems
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-7 md:gap-0">
                {
                  UPSTREAM_OSS.map((item, idx) => (
                    <article
                      class:list={[
                        'space-y-2',
                        idx === 0 && 'md:pr-7 rule-chapter-r-md pb-6 md:pb-0 rule-chapter-b-mobile',
                        idx === 1 && 'md:px-7 rule-chapter-r-md pb-6 md:pb-0 rule-chapter-b-mobile',
                        idx === 2 && 'md:pl-7',
                      ]}
                    >
                      <div class="flex flex-wrap items-baseline justify-between gap-2">
                        <span class="font-mono text-xs text-[var(--chapter-subtle)]">{item.stats}</span>
                        <div class="flex items-center gap-2 font-mono text-xs">
                          {item.links.map((link, lIdx) => (
                            <>
                              {lIdx > 0 && <span class="text-[var(--chapter-rule)]" aria-hidden="true">·</span>}
                              <a
                                href={link.url}
                                target="_blank"
                                rel="noopener"
                                class="py-0.5 text-[var(--chapter-accent)] hover:text-[var(--chapter-fg)] transition-colors"
                              >
                                {link.label} ↗
                              </a>
                            </>
                          ))}
                        </div>
                      </div>

                      <h3 class="font-editorial font-normal text-[21px] leading-snug text-[var(--chapter-fg)]">
                        {item.repo}
                      </h3>

                      <p class="text-[13.5px] leading-[1.58] text-[var(--chapter-muted)]">
                        {item.description}
                      </p>
                    </article>
                  ))
                }
              </div>
            </div>
          </div>

          <!-- Secondary Tier: Compact 3-Column Weekend Builds Strip -->
          <div id="workAppSection" class="space-y-5">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <div class="font-mono text-xs uppercase tracking-[0.14em] text-[var(--chapter-subtle)]">
                Weekend Builds · Tabletop &amp; Party Apps
              </div>
              <div class="font-mono text-xs text-[var(--chapter-subtle)]">
                Small TypeScript web tools built for game nights
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-7 md:gap-0">
              {
                LIVE_APPS.map((app, idx) => (
                  <article
                    class:list={[
                      'space-y-2 flex flex-col justify-between',
                      idx === 0 && 'md:pr-7 rule-chapter-r-md pb-6 md:pb-0 rule-chapter-b-mobile',
                      idx === 1 && 'md:px-7 rule-chapter-r-md pb-6 md:pb-0 rule-chapter-b-mobile',
                      idx === 2 && 'md:pl-7',
                    ]}
                  >
                    <div class="space-y-2">
                      <div class="flex flex-wrap items-baseline justify-between gap-2">
                        <span class="font-mono text-xs text-[var(--chapter-subtle)]">
                          {app.badge}
                        </span>
                        <div class="flex items-center gap-2 font-mono text-xs">
                          {app.repoUrl && (
                            <>
                              <a
                                href={app.repoUrl}
                                target="_blank"
                                rel="noopener"
                                class="py-0.5 text-[var(--chapter-muted)] hover:text-[var(--chapter-fg)] transition-colors"
                              >
                                Source
                              </a>
                              <span class="text-[var(--chapter-rule)]" aria-hidden="true">·</span>
                            </>
                          )}
                          <a
                            href={app.url}
                            target="_blank"
                            rel="noopener"
                            class="py-0.5 text-[var(--chapter-accent)] hover:text-[var(--chapter-fg)] transition-colors"
                          >
                            Open ↗
                          </a>
                        </div>
                      </div>

                      <h3 class="font-editorial font-normal text-[21px] leading-snug text-[var(--chapter-fg)]">
                        <a
                          href={app.url}
                          target="_blank"
                          rel="noopener"
                          class="hover:text-[var(--chapter-accent)] transition-colors"
                        >
                          {app.title}
                        </a>
                      </h3>

                      <p class="text-[13.5px] leading-[1.58] text-[var(--chapter-muted)]">
                        {app.description}
                      </p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- CHAPTER III: SPEEDCUBING SPECIMEN SHEET (Back to Warm Paper)        -->
    <!-- =================================================================== -->
    <WcaSection wca={wca} />

    <!-- Optional Writing Preview (auto-renders once local MDX essays exist) -->
    {
      publishedPosts.length > 0 && (
        <section id="writing" class="max-w-5xl mx-auto px-5 sm:px-10 pb-14 space-y-5">
          <div class="flex items-baseline justify-between rule-dotted-b pb-3">
            <h2 class="font-editorial font-normal text-3xl text-[var(--fg)]">Notes &amp; Essays</h2>
            <a href="/writing" class="font-mono text-xs text-[var(--accent)] hover:underline underline-offset-4">
              All notes ↗
            </a>
          </div>
          <ul class="divide-y divide-dotted divide-[var(--border-dotted)]">
            {publishedPosts.slice(0, 4).map((post) => (
              <li class="py-3.5 first:pt-0">
                <a
                  href={`/writing/${post.id}`}
                  class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 group"
                >
                  <span class="font-editorial text-xl text-[var(--fg)] group-hover:text-[var(--accent)] transition-colors">
                    {post.data.title}
                  </span>
                  <time
                    datetime={post.data.publishedAt.toISOString()}
                    class="font-mono text-xs text-[var(--fg-subtle)] shrink-0"
                  >
                    {post.data.publishedAt.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                    })}
                  </time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>

  <SiteFooter />
  <CommandPalette />
</BaseLayout>

<script>
  // Honest Copy Email button (with timeout clear + global toast fallback)
  const copyBtn = document.getElementById('copyEmailBtn') as HTMLButtonElement | null;
  const copyLabel = document.getElementById('copyEmailLabel');
  let copyTimer: number | null = null;

  copyBtn?.addEventListener('click', async () => {
    const fn = (window as unknown as { __ayushCopyEmail?: () => Promise<boolean> }).__ayushCopyEmail;
    const ok = fn ? await fn() : false;
    if (ok && copyLabel) {
      copyLabel.textContent = 'copied ✓';
      if (copyTimer) window.clearTimeout(copyTimer);
      copyTimer = window.setTimeout(() => {
        copyLabel.textContent = 'copy';
      }, 2200);
    }
  });

  // Work section accessible filter tabs (2-tier layout)
  const workTabs = document.querySelectorAll<HTMLButtonElement>('.work-tab');
  const ossSection = document.getElementById('workOssSection');
  const appSection = document.getElementById('workAppSection');

  workTabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.workTab;
      workTabs.forEach((b) => {
        const active = b === btn;
        b.setAttribute('aria-selected', active ? 'true' : 'false');
        b.className = active
          ? 'work-tab py-1.5 min-h-[38px] text-[var(--chapter-fg)] border-b-2 border-[var(--chapter-accent)] font-medium transition-colors cursor-pointer'
          : 'work-tab py-1.5 min-h-[38px] text-[var(--chapter-subtle)] border-b-2 border-transparent hover:text-[var(--chapter-fg)] transition-colors cursor-pointer';
      });

      if (ossSection && appSection) {
        const showOss = target === 'all' || target === 'oss';
        const showApp = target === 'all' || target === 'app';
        ossSection.classList.toggle('hidden', !showOss);
        appSection.classList.toggle('hidden', !showApp);
        ossSection.classList.toggle('rule-chapter-b', showOss && showApp);
        ossSection.classList.toggle('pb-9', showOss && showApp);
      }
    });
  });
</script>
