---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CommandPalette from '../../components/CommandPalette.astro';
import { PROFILE } from '../../data/profile';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} — ${PROFILE.name}`} description={post.data.description}>
  <SiteHeader active="writing" />

  <main id="main-content" class="flex-1 max-w-5xl w-full mx-auto px-5 sm:px-10 py-12">
    <div class="max-w-3xl space-y-6">
      <a
        href="/writing"
        class="inline-flex items-center gap-1.5 font-mono text-xs text-[var(--fg-subtle)] hover:text-[var(--accent)] transition-colors"
      >
        ← All writing
      </a>

      <article class="space-y-7">
        <header class="space-y-2.5 rule-dotted-b pb-6">
          <time
            datetime={post.data.publishedAt.toISOString()}
            class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--accent)]"
          >
            {
              post.data.publishedAt.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })
            }
          </time>
          <h1 class="font-editorial font-normal text-3xl sm:text-5xl leading-[1.05] tracking-[-0.025em] text-[var(--fg)]">
            {post.data.title}
          </h1>
          <p class="text-[15.5px] text-[var(--fg-muted)] leading-relaxed">{post.data.description}</p>
        </header>

        <div class="space-y-4 text-[16px] leading-[1.7] text-[var(--fg-muted)] [&_h2]:font-editorial [&_h2]:text-2xl [&_h2]:text-[var(--fg)] [&_h2]:pt-5 [&_a]:text-[var(--accent)] [&_a]:underline [&_a]:underline-offset-4 [&_code]:font-mono [&_code]:text-xs [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:bg-[var(--surface)] [&_code]:border [&_code]:border-[var(--border)]">
          <Content />
        </div>
      </article>
    </div>
  </main>

  <SiteFooter />
  <CommandPalette />
</BaseLayout>
