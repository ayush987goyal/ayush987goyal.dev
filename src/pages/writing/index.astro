---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CommandPalette from '../../components/CommandPalette.astro';
import { PROFILE, PUBLISHED_WRITING } from '../../data/profile';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
---

<BaseLayout
  title={`Writing — ${PROFILE.name}`}
  description={`Published articles and technical writing by ${PROFILE.name}.`}
>
  <SiteHeader active="writing" />

  <main id="main-content" class="flex-1 max-w-5xl w-full mx-auto px-5 sm:px-10 py-12 sm:py-16 space-y-12">
    <div class="max-w-3xl space-y-3 rule-dotted-b pb-6">
      <div class="font-mono text-xs uppercase tracking-[0.16em] text-[var(--accent)]">
        Published &amp; Engineering Notes
      </div>
      <h1 class="font-editorial font-normal text-4xl sm:text-5xl tracking-[-0.025em] text-[var(--fg)]">
        Writing
      </h1>
      <p class="text-[15.5px] text-[var(--fg-muted)] leading-relaxed">
        Official AWS blog publications and technical notes on full-stack architecture, cloud infrastructure, and AI developer tooling.
      </p>
    </div>

    <!-- Official / External Publications -->
    <section class="max-w-3xl space-y-4">
      <div class="font-mono text-xs uppercase tracking-[0.16em] text-[var(--fg-subtle)]">
        Published Articles
      </div>
      <ul class="divide-y divide-dotted divide-[var(--border-dotted)] rule-dotted-t rule-dotted-b">
        {
          PUBLISHED_WRITING.map((item) => (
            <li class="py-6">
              <a href={item.url} target="_blank" rel="noopener" class="block group space-y-2">
                <div class="flex flex-wrap items-baseline justify-between gap-2 font-mono text-xs uppercase tracking-[0.14em]">
                  <span class="text-[var(--accent)]">{item.venue}</span>
                  <span class="text-[var(--fg-subtle)]">{item.date} · External ↗</span>
                </div>
                <h2 class="font-editorial font-normal text-2xl sm:text-[26px] leading-snug text-[var(--fg)] group-hover:text-[var(--accent)] transition-colors">
                  {item.title}
                </h2>
                <p class="text-[14.5px] text-[var(--fg-muted)] leading-relaxed">{item.summary}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Local Notes & Dispatches (renders once local posts exist) -->
    {
      posts.length > 0 && (
        <section class="max-w-3xl space-y-4">
          <div class="font-mono text-xs uppercase tracking-[0.16em] text-[var(--fg-subtle)]">
            Notes &amp; Dispatches
          </div>
          <ul class="divide-y divide-dotted divide-[var(--border-dotted)] rule-dotted-t rule-dotted-b">
            {posts.map((post) => (
              <li class="py-5">
                <a href={`/writing/${post.id}`} class="block group space-y-1.5">
                  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                    <h2 class="font-editorial font-normal text-2xl text-[var(--fg)] group-hover:text-[var(--accent)] transition-colors">
                      {post.data.title}
                    </h2>
                    <time
                      datetime={post.data.publishedAt.toISOString()}
                      class="font-mono text-xs text-[var(--fg-subtle)] shrink-0"
                    >
                      {post.data.publishedAt.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                      })}
                    </time>
                  </div>
                  <p class="text-sm text-[var(--fg-muted)] leading-relaxed">{post.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>

  <SiteFooter />
  <CommandPalette />
</BaseLayout>
